      <bpmndi:BPMNShape id="s_h5" bpmnElement="h5"><dc:Bounds x="1175" y="512" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f0" bpmnElement="f0"><di:waypoint x="120" y="110"/><di:waypoint x="120" y="240"/><di:waypoint x="214" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="326" y="240"/><di:waypoint x="455" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="480" y="265"/><di:waypoint x="480" y="360"/><bpmndi:BPMNLabel><dc:Bounds x="485" y="304" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><di:waypoint x="505" y="240"/><di:waypoint x="635" y="240"/><bpmndi:BPMNLabel><dc:Bounds x="540" y="222" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4"><di:waypoint x="660" y="215"/><di:waypoint x="660" y="188"/><di:waypoint x="822" y="188"/><bpmndi:BPMNLabel><dc:Bounds x="665" y="194" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5"><di:waypoint x="685" y="240"/><di:waypoint x="840" y="240"/><di:waypoint x="840" y="520"/><bpmndi:BPMNLabel><dc:Bounds x="732" y="222" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6"><di:waypoint x="480" y="440"/><di:waypoint x="480" y="560"/><di:waypoint x="784" y="560"/><bpmndi:BPMNLabel><dc:Bounds x="485" y="492" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7" bioc:stroke="#c4501c" color:border-color="#c4501c"><di:waypoint x="840" y="600"/><di:waypoint x="840" y="720"/><di:waypoint x="994" y="720"/><bpmndi:BPMNLabel><dc:Bounds x="845" y="652" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f8" bpmnElement="f8"><di:waypoint x="896" y="560"/><di:waypoint x="1092" y="560"/></bpmndi:BPMNEdge>
