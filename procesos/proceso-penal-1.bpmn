<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="def_p_proceso_penal_1" targetNamespace="https://github.com/fsotosa-ops/justicia-restaurativa" exporter="justicia-restaurativa/mapa/procesos/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="col_p_proceso_penal_1">
    <bpmn:participant id="pool_p_proceso_penal_1" name="Proceso penal (Ley 906 de 2004), hoja 1 de 2" processRef="p_proceso_penal_1"/>
    <bpmn:participant id="victima" name="Víctima"/>
    <bpmn:messageFlow id="mf0" sourceRef="victima" targetRef="inicio" name="Denuncia o querella"/>
  </bpmn:collaboration>
  <bpmn:process id="p_proceso_penal_1" name="Proceso penal (Ley 906 de 2004), hoja 1 de 2" isExecutable="false">
    <bpmn:laneSet id="ls_p_proceso_penal_1">
      <bpmn:lane id="lane_rec" name="Recepción de denuncias (SAU, URI)">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_con" name="Conciliador">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_conc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_fis" name="Fiscal delegado">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_hoja2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Denuncia o querella">
      <bpmn:outgoing>f0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_inicio"/>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="1. Recibir la denuncia o querella">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 67 a 69</bpmn:documentation>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="¿Delito querellable?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="2. Citar a conciliación preprocesal">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 522</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="¿Hay acuerdo?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fin_conc" name="Se archiva por conciliación">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t4" name="3. Adelantar la indagación">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 200</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="¿Hay mérito?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fin_arch" name="Archivo de las diligencias">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="a_hoja2" name="Continúa en la hoja 2">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:linkEventDefinition id="led_a_hoja2" name="Imputación"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="inicio" targetRef="t1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="g1" targetRef="t3" name="Querellable"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t3" targetRef="g2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g2" targetRef="fin_conc" name="Sí"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g2" targetRef="t4" name="No"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="De oficio"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="g3"/>
    <bpmn:sequenceFlow id="f8" sourceRef="g3" targetRef="fin_arch" name="No"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g3" targetRef="a_hoja2" name="Sí"/>
  </bpmn:process>
