<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="def_p_comisaria_3" targetNamespace="https://github.com/fsotosa-ops/justicia-restaurativa" exporter="justicia-restaurativa/mapa/procesos/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="col_p_comisaria_3">
    <bpmn:participant id="pool_p_comisaria_3" name="Comisaría de familia, hoja 3 de 3" processRef="p_comisaria_3"/>
    <bpmn:participant id="persona" name="Persona usuaria"/>
    <bpmn:participant id="entidades" name="Entidades de la ruta (Fiscalía, Policía, Medicina Legal, Secretaría de la Mujer)"/>
    <bpmn:messageFlow id="mf0" sourceRef="t12" targetRef="entidades" name="Denuncia"/>
    <bpmn:messageFlow id="mf1" sourceRef="t13" targetRef="entidades" name="Oficios"/>
    <bpmn:messageFlow id="mf2" sourceRef="t14" targetRef="persona" name="Notificación (act. 8)"/>
    <bpmn:association id="asoc0" sourceRef="n_med" targetRef="entidades"/>
  </bpmn:collaboration>
  <bpmn:process id="p_comisaria_3" name="Comisaría de familia, hoja 3 de 3" isExecutable="false">
    <bpmn:laneSet id="ls_p_comisaria_3">
      <bpmn:lane id="lane_com" name="Comisario(a) de familia">
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sec" name="Secretaría del despacho">
        <bpmn:flowNodeRef>de_hoja2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="de_hoja2" name="Viene de la hoja 2">
      <bpmn:outgoing>f0</bpmn:outgoing>
      <bpmn:linkEventDefinition id="led_de_hoja2" name="Medidas provisionales"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t11" name="11. Proyectar auto que avoca conocimiento y decreta medidas provisionales">
      <bpmn:documentation>Fuente: MinJusticia y PNUD (2022), Tomo V, fase 2, act. 1, p. 23</bpmn:documentation>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="¿El auto está conforme?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t12" name="12. Diligenciar el formato de denuncia">
      <bpmn:documentation>Fuente: MinJusticia y PNUD (2022), Tomo V, fase 2, act. 4, p. 24</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="13. Elaborar los oficios de la medida">
      <bpmn:documentation>Fuente: MinJusticia y PNUD (2022), Tomo V, fase 2, act. 5, p. 24</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="14. Elaborar las notificaciones">
      <bpmn:documentation>Fuente: MinJusticia y PNUD (2022), Tomo V, fase 2, act. 7, p. 24</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="sp" name="15. Pruebas, audiencia, medida definitiva y seguimiento">
      <bpmn:documentation>Fuente: MinJusticia y PNUD (2022), Tomo V, fase 2 (acts. 9 a 19) y fases 3 a 8, desde p. 24</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="fin" name="Medida cerrada">
      <bpmn:incoming>f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="n_med"><bpmn:text>La comisaría no remite a mediación penal: solo el fiscal o el juez (Res. 0383 de 2022, art. 14)</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f0" sourceRef="de_hoja2" targetRef="t11"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t11" targetRef="g2"/>
    <bpmn:sequenceFlow id="f2" sourceRef="g2" targetRef="t11" name="No"/>
    <bpmn:sequenceFlow id="f3" sourceRef="g2" targetRef="t12" name="Sí"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t12" targetRef="t13"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t13" targetRef="t14"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t14" targetRef="sp"/>
    <bpmn:sequenceFlow id="f7" sourceRef="sp" targetRef="fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_p_comisaria_3">
    <bpmndi:BPMNPlane id="pl_p_comisaria_3" bpmnElement="col_p_comisaria_3">
      <bpmndi:BPMNShape id="s_pool" bpmnElement="pool_p_comisaria_3" isHorizontal="true"><dc:Bounds x="0" y="110" width="1305" height="320"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_persona" bpmnElement="persona" isHorizontal="true"><dc:Bounds x="0" y="0" width="1305" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_entidades" bpmnElement="entidades" isHorizontal="true"><dc:Bounds x="0" y="480" width="1305" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane_com" bpmnElement="lane_com" isHorizontal="true"><dc:Bounds x="30" y="110" width="1275" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane_sec" bpmnElement="lane_sec" isHorizontal="true"><dc:Bounds x="30" y="270" width="1275" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_de_hoja2" bpmnElement="de_hoja2"><dc:Bounds x="102" y="332" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="65" y="374" width="110" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_t11" bpmnElement="t11"><dc:Bounds x="214" y="310" width="112" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_g2" bpmnElement="g2"><dc:Bounds x="395" y="165" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="365" y="131" width="110" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_t12" bpmnElement="t12"><dc:Bounds x="514" y="310" width="112" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_t13" bpmnElement="t13"><dc:Bounds x="664" y="310" width="112" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_t14" bpmnElement="t14"><dc:Bounds x="814" y="310" width="112" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_sp" bpmnElement="sp"><dc:Bounds x="964" y="150" width="112" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_fin" bpmnElement="fin"><dc:Bounds x="1152" y="172" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1115" y="214" width="110" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_n_med" bpmnElement="n_med"><dc:Bounds x="1025" y="302" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f0" bpmnElement="f0"><di:waypoint x="138" y="350"/><di:waypoint x="214" y="350"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="326" y="350"/><di:waypoint x="420" y="350"/><di:waypoint x="420" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="395" y="190"/><di:waypoint x="270" y="190"/><di:waypoint x="270" y="310"/><bpmndi:BPMNLabel><dc:Bounds x="302" y="172" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><di:waypoint x="445" y="190"/><di:waypoint x="570" y="190"/><di:waypoint x="570" y="310"/><bpmndi:BPMNLabel><dc:Bounds x="478" y="172" width="60" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4"><di:waypoint x="626" y="350"/><di:waypoint x="664" y="350"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5"><di:waypoint x="776" y="350"/><di:waypoint x="814" y="350"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6"><di:waypoint x="870" y="310"/><di:waypoint x="870" y="190"/><di:waypoint x="964" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7"><di:waypoint x="1076" y="190"/><di:waypoint x="1152" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_mf0" bpmnElement="mf0"><di:waypoint x="570" y="390"/><di:waypoint x="570" y="480"/><bpmndi:BPMNLabel><dc:Bounds x="576" y="428" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_mf1" bpmnElement="mf1"><di:waypoint x="720" y="390"/><di:waypoint x="720" y="480"/><bpmndi:BPMNLabel><dc:Bounds x="726" y="428" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_mf2" bpmnElement="mf2"><di:waypoint x="840" y="310"/><di:waypoint x="840" y="60"/><bpmndi:BPMNLabel><dc:Bounds x="846" y="178" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_asoc0" bpmnElement="asoc0"><di:waypoint x="1110" y="398"/><di:waypoint x="1110" y="480"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
