<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="def_p_proceso_penal_2" targetNamespace="https://github.com/fsotosa-ops/justicia-restaurativa" exporter="justicia-restaurativa/mapa/procesos/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="col_p_proceso_penal_2">
    <bpmn:participant id="pool_p_proceso_penal_2" name="Proceso penal (Ley 906 de 2004), hoja 2 de 2" processRef="p_proceso_penal_2"/>
    <bpmn:participant id="victima" name="Víctima"/>
    <bpmn:messageFlow id="mf0" sourceRef="victima" targetRef="cm" name="Solicita la mediación"/>
  </bpmn:collaboration>
  <bpmn:process id="p_proceso_penal_2" name="Proceso penal (Ley 906 de 2004), hoja 2 de 2" isExecutable="false">
    <bpmn:laneSet id="ls_p_proceso_penal_2">
      <bpmn:lane id="lane_con" name="Mediador">
        <bpmn:flowNodeRef>cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_med</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_fis" name="Fiscal delegado">
        <bpmn:flowNodeRef>de_hoja1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_jue" name="Juez de garantías o de conocimiento">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="de_hoja1" name="Viene de la hoja 1">
      <bpmn:outgoing>f0</bpmn:outgoing>
      <bpmn:linkEventDefinition id="led_de_hoja1" name="Imputación"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="4. Formular la imputación ante el juez de garantías">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 286 a 288 (abreviado: art. 536)</bpmn:documentation>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g4" name="¿Qué salida aplica?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="cm" name="5. Mediación penal">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 523 a 527; Resolución FGN 0383 de 2022</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="g5" name="¿Hay acuerdo?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="6. Remitir el acta al fiscal, que la lleva al juez">
      <bpmn:documentation>Fuente: Resolución FGN 0383 de 2022, arts. 19 y 22</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_med" name="Acta ante el juez">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t7" name="7. Control de legalidad del principio de oportunidad">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 323 a 327</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_op" name="Se suspende o extingue la acción">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gm" name="">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="8. Formular la acusación">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 336</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="9. Juicio oral y sentencia">
      <bpmn:documentation>Fuente: Ley 906 de 2004, libro III</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="10. Incidente de reparación integral">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 102 a 108</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Proceso terminado">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="n_med"><bpmn:text>Mediación: en el ordinario, desde la imputación hasta antes del juicio, con pena mínima de hasta 5 años, bien jurídico personal y aceptación expresa de ambas partes; en el abreviado, hasta antes del fallo (arts. 524 y 547)</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f0" sourceRef="de_hoja1" targetRef="t5"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t5" targetRef="g4"/>
    <bpmn:sequenceFlow id="f2" sourceRef="g4" targetRef="cm" name="Mediación"/>
    <bpmn:sequenceFlow id="f3" sourceRef="g4" targetRef="t7" name="Oportunidad"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t7" targetRef="fin_op"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g4" targetRef="gm" name="Ninguna"/>
    <bpmn:sequenceFlow id="f6" sourceRef="cm" targetRef="g5"/>
    <bpmn:sequenceFlow id="f7" sourceRef="g5" targetRef="t6" name="Sí"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="fin_med"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g5" targetRef="gm" name="No"/>
    <bpmn:sequenceFlow id="f10" sourceRef="gm" targetRef="t8"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t10" targetRef="fin"/>
    <bpmn:association id="asoc0" sourceRef="t5" targetRef="n_med"/>
  </bpmn:process>
