<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="def_p_comisaria" targetNamespace="https://github.com/fsotosa-ops/justicia-restaurativa" exporter="justicia-restaurativa/mapa/procesos/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="col_p_comisaria">
    <bpmn:participant id="pool_p_comisaria" name="Comisaría de familia: recepción de un caso de violencia en el contexto familiar" processRef="p_comisaria"/>
    <bpmn:participant id="persona" name="Persona usuaria"/>
    <bpmn:participant id="entidades" name="Entidades de la ruta (Fiscalía, Policía, Medicina Legal, Secretaría de la Mujer)"/>
    <bpmn:messageFlow id="mf0" sourceRef="persona" targetRef="inicio" name="Solicita atención"/>
    <bpmn:messageFlow id="mf1" sourceRef="t4" targetRef="persona" name="Oficio remisorio"/>
    <bpmn:messageFlow id="mf2" sourceRef="t12" targetRef="entidades" name="Denuncia"/>
    <bpmn:messageFlow id="mf3" sourceRef="t13" targetRef="entidades" name="Oficios"/>
    <bpmn:messageFlow id="mf4" sourceRef="t14" targetRef="persona" name="Notificación"/>
  </bpmn:collaboration>
  <bpmn:process id="p_comisaria" name="Comisaría de familia: recepción de un caso de violencia en el contexto familiar" isExecutable="false">
    <bpmn:laneSet id="ls_p_comisaria">
      <bpmn:lane id="lane_com" name="Comisario(a) de familia">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_remitido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_seg" name="Personal de seguridad">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_pro" name="Profesional de recepción">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sec" name="Secretaría del despacho">
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Llega una persona a la comisaría">
      <bpmn:messageEventDefinition id="med_inicio"/>
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="1. Registrar el ingreso">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 1, p. 17</bpmn:documentation>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="2. Registrar la información básica">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 2, p. 18</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="3. Indagar el motivo de consulta">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 3, p. 18</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="¿Es competencia de la comisaría?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="4. Remitir por oficio a la entidad competente">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 4, pp. 18-19</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_remitido" name="Caso remitido">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="5. Valoración inicial psicológica y emocional">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 5, p. 19</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="6. Identificar el riesgo">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 6, p. 19</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="7. Iniciar la solicitud de medida de protección">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 7, p. 19</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="8. Abrir el trámite en el sistema">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 10, p. 21</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="9. Verificar el nivel del riesgo">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 13, p. 22</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="10. Elaborar el informe de la entrevista">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 1, act. 14, p. 22</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="11. Proyectar auto que avoca conocimiento y decreta medidas provisionales">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 2, act. 1, p. 23</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="¿El auto está conforme?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t12" name="12. Diligenciar el formato de denuncia">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 2, act. 4, p. 24</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="13. Elaborar los oficios de la medida">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 2, act. 5, p. 24</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="14. Notificar a las partes">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fase 2, act. 7 y 8, p. 24</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="sp1" name="15. Medidas de atención, audiencia y medida definitiva">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fases 3 a 5, pp. 26-43</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="sp2" name="16. Seguimiento, incumplimiento y levantamiento">
      <bpmn:documentation>Fuente: MinJusticia (2022), Tomo V, fases 6 a 8, desde p. 44</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="fin" name="Medida cerrada">
      <bpmn:incoming>f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="n_nna"><bpmn:text>Con niños, niñas o adolescentes: verificar sus derechos y pedir consentimiento (act. 8, 9, 11 y 12)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_med"><bpmn:text>La comisaría no remite a mediación penal: solo el fiscal o el juez (Res. 0383 de 2022, art. 14)</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f0" sourceRef="inicio" targetRef="t1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t4" name="No"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="fin_remitido"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t5" name="Sí"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="f9" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t11" targetRef="g2"/>
    <bpmn:sequenceFlow id="f14" sourceRef="g2" targetRef="t11" name="No"/>
    <bpmn:sequenceFlow id="f15" sourceRef="g2" targetRef="t12" name="Sí"/>
    <bpmn:sequenceFlow id="f16" sourceRef="t12" targetRef="t13"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t13" targetRef="t14"/>
    <bpmn:sequenceFlow id="f18" sourceRef="t14" targetRef="sp1"/>
    <bpmn:sequenceFlow id="f19" sourceRef="sp1" targetRef="sp2"/>
    <bpmn:sequenceFlow id="f20" sourceRef="sp2" targetRef="fin"/>
    <bpmn:association id="asoc0" sourceRef="t8" targetRef="n_nna"/>
    <bpmn:association id="asoc1" sourceRef="t12" targetRef="n_med"/>
  </bpmn:process>
