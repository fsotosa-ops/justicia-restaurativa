<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="def_p_proceso-penal" targetNamespace="https://github.com/fsotosa-ops/justicia-restaurativa" exporter="justicia-restaurativa/mapa/procesos/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="col_p_proceso-penal">
    <bpmn:participant id="pool_p_proceso-penal" name="Proceso penal (Ley 906 de 2004) y salidas restaurativas" processRef="p_proceso-penal"/>
    <bpmn:participant id="victima" name="Víctima"/>
    <bpmn:messageFlow id="mf0" sourceRef="victima" targetRef="inicio" name="Denuncia o querella"/>
    <bpmn:messageFlow id="mf1" sourceRef="victima" targetRef="cm" name="Solicita la mediación"/>
  </bpmn:collaboration>
  <bpmn:process id="p_proceso-penal" name="Proceso penal (Ley 906 de 2004) y salidas restaurativas" isExecutable="false">
    <bpmn:laneSet id="ls_p_proceso-penal">
      <bpmn:lane id="lane_rec" name="Recepción de denuncias (SAU, URI)">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_con" name="Conciliador o mediador">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_conc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_med</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_fis" name="Fiscal delegado">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_jue" name="Juez de garantías o de conocimiento">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Denuncia o querella">
      <bpmn:messageEventDefinition id="med_inicio"/>
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="1. Recibir la denuncia o querella">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 67 a 69</bpmn:documentation>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="¿Delito querellable?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="2. Citar a conciliación preprocesal">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 522</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="¿Hay acuerdo?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fin_conc" name="Se archiva por conciliación">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t4" name="3. Adelantar la indagación">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 200</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="¿Hay mérito?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fin_arch" name="Archivo de las diligencias">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="4. Formular la imputación ante el juez de garantías">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 286 a 288 (abreviado: art. 536)</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g4" name="¿Qué salida aplica?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="cm" name="5. Mediación penal (lámina 4)">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 523 a 527; Resolución FGN 0383 de 2022</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="g5" name="¿Hay acuerdo?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="6. Remitir el acta al fiscal, que la lleva al juez">
      <bpmn:documentation>Fuente: Resolución FGN 0383 de 2022, arts. 19 y 22</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_med" name="Acta ante el juez">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t7" name="7. Control de legalidad del principio de oportunidad">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 323 a 327</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_op" name="Se suspende o extingue la acción">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gm" name="">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="8. Formular la acusación">
      <bpmn:documentation>Fuente: Ley 906 de 2004, art. 336</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="9. Juicio oral y sentencia">
      <bpmn:documentation>Fuente: Ley 906 de 2004, libro III</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="10. Incidente de reparación integral">
      <bpmn:documentation>Fuente: Ley 906 de 2004, arts. 102 a 108</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Proceso terminado">
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="n_med"><bpmn:text>Ordinario: desde la imputación hasta antes del juicio, pena mínima de hasta 5 años. Abreviado: hasta antes del fallo (arts. 524, 525 y 547)</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f0" sourceRef="inicio" targetRef="t1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="g1" targetRef="t3" name="Querellable"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t3" targetRef="g2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g2" targetRef="fin_conc" name="Sí"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g2" targetRef="t4" name="No"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="De oficio"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="g3"/>
    <bpmn:sequenceFlow id="f8" sourceRef="g3" targetRef="fin_arch" name="No"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g3" targetRef="t5" name="Sí"/>
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="g4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="g4" targetRef="cm" name="Mediación"/>
    <bpmn:sequenceFlow id="f12" sourceRef="g4" targetRef="t7" name="Oportunidad"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t7" targetRef="fin_op"/>
    <bpmn:sequenceFlow id="f14" sourceRef="g4" targetRef="gm" name="Ninguna"/>
    <bpmn:sequenceFlow id="f15" sourceRef="cm" targetRef="g5"/>
    <bpmn:sequenceFlow id="f16" sourceRef="g5" targetRef="t6" name="Sí"/>
    <bpmn:sequenceFlow id="f17" sourceRef="t6" targetRef="fin_med"/>
    <bpmn:sequenceFlow id="f18" sourceRef="g5" targetRef="gm" name="No"/>
    <bpmn:sequenceFlow id="f19" sourceRef="gm" targetRef="t8"/>
    <bpmn:sequenceFlow id="f20" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="f21" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="f22" sourceRef="t10" targetRef="fin"/>
    <bpmn:association id="asoc0" sourceRef="cm" targetRef="n_med"/>
  </bpmn:process>
